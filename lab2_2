#include <iostream>                          // без этого не заработают cout и cin

int main()                                   // отсюда программа начинает работать
{                                            // открываем main
    int n;                                   // сюда запишем число от пользователя

    while (true)                             // цикл без конца, выйдем из него сами через break
    {                                        // открываем цикл
        std::cout << "Введите целое положительное число: ";  // просим ввести число
        std::cin >> n;                       // забираем то, что человек напечатал, кладём в n
        if (n > 0)                           // число больше нуля? значит всё ок
        {                                    // открываем if
            break;                           // всё ок, вылетаем из цикла
        }                                    // закрываем if
    }                                        // закрываем цикл (если число плохое, спросим ещё раз)

    int sum = 0;                             // тут будем копить сумму, начинаем с нуля
    std::cout << "1";                        // печатаем единицу, чтобы перед ней не было лишнего плюса
    for (int i = 2; i <= n; i++)             // идём от 2 до n, единицу мы уже напечатали
    {                                        // открываем for
        std::cout << " + " << i;             // печатаем " + 2", потом " + 3" и так дальше
    }                                        // закрываем for
    for (int i = 1; i <= n; i++)             // теперь считаем сумму, идём от 1 до n
    {                                        // открываем for
        sum = sum + i;                       // добавляем текущее число к сумме
    }                                        // закрываем for
    std::cout << " = " << sum << std::endl;  // дописываем " = 10" и переходим на новую строку

    int arr[10] = { 5, 12, 7, 3, 20, 8, 15, 1, 9, 6 };  // массив из 10 чисел, взял какие захотел

    for (int i = 0; i < 10; i++)             // идём по массиву: индексы от 0 до 9
    {                                        // открываем for
        std::cout << arr[i] << " ";          // печатаем число и пробел после него
    }                                        // закрываем for
    std::cout << std::endl;                  // новая строка, чтобы дальше не слипалось

    std::cout << "Чётные позиции: ";         // просто подпись, чтобы было понятно что выводим
    for (int i = 0; i < 10; i++)             // опять идём по всем индексам
    {                                        // открываем for
        if (i % 2 == 0)                      // % это остаток от деления; остаток 0 значит индекс чётный
        {                                    // открываем if
            std::cout << arr[i] << " ";      // печатаем число с чётным индексом
        }                                    // закрываем if
    }                                        // закрываем for
    std::cout << std::endl;                  // новая строка

    int oddSum = 0;                          // сумма чисел на нечётных позициях, начинаем с нуля
    for (int i = 0; i < 10; i++)             // идём по всем индексам
    {                                        // открываем for
        if (i % 2 == 1)                      // остаток 1 значит индекс нечётный (1, 3, 5, 7, 9)
        {                                    // открываем if
            oddSum = oddSum + arr[i];        // добавляем это число к сумме
        }                                    // закрываем if
    }                                        // закрываем for
    std::cout << "Сумма на нечётных позициях: " << oddSum << std::endl;  // показываем итог

    return 0;                                // всё прошло нормально, выходим
}                                            // закрываем main
